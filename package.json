{
  "name": "baobao-today",
  "main": "expo-router/entry",
  "version": "1.2.2",
  "license": "MIT",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.26",
    "@noble/hashes": "2.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.33",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.5",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-file-handle.cjs",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "preandroid": "node ./scripts/patch-expo-file-handle.cjs",
    "android": "expo run:android",
    "android:release": "pwsh -NoProfile -File ./scripts/android-local-build.ps1 -Release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:assets": "node ./scripts/verify-android-assets.mjs",
    "test:ui-assets": "node ./scripts/verify-ui-assets.mjs",
    "test:schema": "node --no-warnings --experimental-strip-types ./scripts/verify-schema.mjs",
    "test:native-patches": "node --test ./scripts/patch-expo-file-handle.test.cjs ./scripts/patch-expo-drive-root.test.cjs",
    "test:release-baseline": "node --test ./scripts/verify-release-baseline.test.mjs && node ./scripts/verify-release-baseline.mjs",
    "test:tooling": "node --test ./scripts/verify.test.mjs ./scripts/local-only-backup.test.cjs",
    "verify": "node ./scripts/verify.mjs",
    "verify:android-tools": "pwsh -NoProfile -File ./scripts/android-local-build.test.ps1 && pwsh -NoProfile -File ./scripts/android-release-audit.test.ps1 && pwsh -NoProfile -File ./scripts/android-release-key-setup.test.ps1",
    "verify:expo": "npx --yes expo-doctor@1.20.4 && npx expo install --check && npx expo config --type public && npx expo export --platform android --max-workers 2 --output-dir .runtime/verify/android-export",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/test/style-mock.js"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system",
          "expo-sqlite"
        ]
      }
    }
  },
  "private": true
}
